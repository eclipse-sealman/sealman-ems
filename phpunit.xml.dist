<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         controlGarbageCollector="true"
         numberOfTestsBeforeGarbageCollection="100"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerDeprecations="false"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true" 
         testdox="true"
>
    <php>
        <ini name="display_errors" value="On" />
        <ini name="display_startup_errors" value="On" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
    </php>

    <testsuites>
        <!-- Scenario testsuites -->
        <testsuite name="Scenario:WebApi">
            <directory>tests/suites/Scenario/WebApi</directory>
        </testsuite>

        <!-- Unit testsuites -->
        <testsuite name="Unit:HttpClient">
            <directory>tests/suites/Unit/HttpClient</directory>
        </testsuite>
       
        <!-- WebApi testsuites -->
        <testsuite name="WebApi:Endpoint">
            <directory>tests/suites/WebApi/Endpoint</directory>
        </testsuite>
        <testsuite name="WebApi:Documentation">
            <directory>tests/suites/WebApi/Documentation</directory>
        </testsuite>
    </testsuites>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions> 
    <!-- Run `composer require symfony/panther` before enabling this extension -->
    <!--
    <extensions>
        <extension class="Symfony\Component\Panther\ServerExtension" />
    </extensions>
    -->
</phpunit>
